<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>

		<!-- Generate XML documentation for Swagger -->
		<GenerateDocumentationFile>true</GenerateDocumentationFile>

		<!-- Ignore missing XML comments on classes and methods -->
		<NoWarn>$(NoWarn);1591</NoWarn>
		<UserSecretsId>c8bcffb4-43ee-48c4-b8d0-d9547d0042fb</UserSecretsId>
	</PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Data.Tables" Version="12.13.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.3.1" />
  </ItemGroup>

</Project>
